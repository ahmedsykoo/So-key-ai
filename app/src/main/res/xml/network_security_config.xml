<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ResourceName">
    <!--
      So-key Ai talks to AI providers that legitimately live on the LAN or on the
      device itself: OmniRoute (http://127.0.0.1:20128 by default), Ollama,
      LM Studio, vLLM … Those endpoints are plain HTTP, so cleartext has to be
      allowed. Public traffic still goes over TLS.
    -->
    <network-security-config>
        <base-config cleartextTrafficPermitted="true">
            <trust-anchors>
                <certificates src="system" />
                <certificates src="user" />
            </trust-anchors>
        </base-config>
    </network-security-config>
</resources>
